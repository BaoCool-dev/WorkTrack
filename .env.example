# Sao chép thành .env (không commit .env). Claude bị chặn đọc .env*.

# Backend
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://worktrack:worktrack@localhost:5432/worktrack?sslmode=disable
JWT_SECRET=change-me-at-least-32-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
CORS_ORIGIN=http://localhost:5173

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
AI_TIMEOUT=15s

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080

# ---- Chỉ cho Claude Code MCP (đặt trong shell profile, không phải .env của app) ----
# export CONTEXT7_API_KEY=...
# export WORKTRACK_MCP_DATABASE_URI=postgresql://worktrack_ro:...@host.docker.internal:5432/worktrack
