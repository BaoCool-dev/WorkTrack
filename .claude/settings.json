      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(chmod +x:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(diff:*)",
      "Bash(touch:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-list:*)",
      "Bash(git merge-base:*)",
      "Bash(git restore:*)",
      "Bash(git push -u origin feature/:*)",
      "Bash(git push -u origin chore/:*)",
      "Bash(git push -u origin fix/:*)",
      "Bash(git push origin feature/:*)",
      "Bash(git push origin chore/:*)",
      "Bash(git push origin fix/:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh issue create:*)",
      "Read(./**)",
      "Edit(./**)",
      "WebSearch",
      "WebFetch",
      "Bash(git push -u origin test/:*)",
      "Bash(git push origin test/:*)",
      "Bash(./scripts/run-all-tests.sh:*)",
      "Bash(go install:*)",
      "Bash(deadcode:*)",
      "Bash(npx knip:*)",
      "Bash(git merge --continue)",
      "Bash(git merge --abort)",
      "Bash(git revert:*)",
      "Bash(git checkout --ours:*)",
