      "Bash(go get:*)",
      "Bash(go mod init:*)",
      "Bash(go run:*)",
      "Bash(go generate:*)",
      "Bash(go tool:*)",
      "Bash(go list:*)",
      "Bash(go env:*)",
      "Bash(go version)",
      "Bash(goose:*)",
      "Bash(sqlc:*)",
      "Bash(gitleaks:*)",
      "Bash(npm create:*)",
      "Bash(npm exec:*)",
      "Bash(npx playwright:*)",
      "Bash(npx msw:*)",
      "Bash(node --version)",
      "Bash(docker compose up:*)",
      "Bash(docker compose build:*)",
      "Bash(docker compose exec:*)",
