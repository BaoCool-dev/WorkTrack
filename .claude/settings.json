      "Bash(goose -dir:*)"
    ],
    "ask": [
      "Bash(docker compose down:*)",
      "mcp__postgres"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(docker compose down -v:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin +main:*)",
      "Bash(git push --delete:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git merge main:*)",
      "Bash(git checkout main -- :*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo delete:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker system prune:*)",
      "Bash(make migrate-down:*)",
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./**/.env)",
      "Edit(./**/.env)",
      "Read(./.env.local)",
      "Edit(./.env.local)",
      "Read(./**/.env.local)",
      "Edit(./**/.env.local)",
      "Read(./.env.development)",
      "Edit(./.env.development)",
      "Read(./.env.production)",
      "Edit(./.env.production)",
      "Read(./.env.test)",
      "Edit(./.env.test)",
      "Read(./**/.env.*.local)",
      "Edit(./**/.env.*.local)",
      "Bash(cat .env:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-generated.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-on-edit.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/capture_prompt.py"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "samber": {
      "source": {
        "source": "github",
        "repo": "samber/cc"
      }
    }
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "cc-skills-golang@samber": true
  },
  "enableAllProjectMcpServers": true
}
